# NRP K8s System Configuration
# Copy this file to .env and fill in your actual values

# =================================
# NRP LLM Configuration (Optional)
# =================================
# Get your API key from: https://llm.nrp-nautilus.io/
# Note: Both servers work in demo mode without these!
NRP_API_KEY=your_actual_nrp_api_key_here
NRP_BASE_URL=https://llm.nrp-nautilus.io/
NRP_MODEL=gemma3

# =================================
# OpenAI Fallback (Optional)
# =================================
# Fallback LLM configuration
OPENAI_API_KEY=your_openai_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# =================================
# Search Providers (Optional)
# =================================
# For enhanced web search capabilities
SERPER_API_KEY=your_serper_key_here
BING_SEARCH_KEY=your_bing_key_here

# =================================
# Server Configuration
# =================================
# Web server port (default: 5000)
WEB_SERVER_PORT=5000
# MCP server port (default: 8020)
MCP_SERVER_PORT=8020
# Enable debug mode (default: False)
DEBUG_MODE=False

# =================================
# Kubernetes Configuration
# =================================
# Default namespace (default: gsoc)
K8S_NAMESPACE=gsoc
# Enable Kubernetes operations (default: True)
K8S_ENABLED=True
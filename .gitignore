# === OS / IDE junk ===
.DS_Store
Thumbs.db
ehthumbs.db
*.swp
*.swo
*.tmp
*.bak
*.orig
*.log

# === Python ===
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.env
.venv/
.env.*
*.sqlite3

# === Node / JavaScript ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# === Lockfiles (if you want to ignore ALL) ===
*.lock

# But if you want to keep dependency lockfiles, whitelist them:
#!package-lock.json
#!yarn.lock
#!Pipfile.lock

# === Build / Compiled ===
dist/
build/
out/
target/
coverage/
*.coverage
*.class
*.o
*.so
*.dll
*.exe

# === Secrets / Config ===
*.pem
*.key
*.crt
*.cert
*.p12
*.jks
*.kdb
*.db
*.sqlite
*.env.local
secrets.*
credentials.*

# === NRP K8s System Specific ===
# Virtual Environments
nrp_k8s_system/venv/

# Keep important knowledge bases (include these)
!mcp/cache/*.py
!mcp/cache/*.json
!mcp/cache/*.md
!nrp_k8s_system/cache/fast_knowledge/
!nrp_k8s_system/cache/enhanced_knowledge_base/
!nrp_k8s_system/cache/nautilus_docs/

# Exclude temporary/generated cache files
**/conversation_buffer.json
**/knowledge_updates.json
**/__pycache__/

# Keep environment template but not actual config
!.env.example

# === Git ===
*.patch
*.diff
.claude/settings.local.json
NUL
